{
  "name": "obsidian-note-snapshots",
  "version": "0.1.0",
  "description": "Per-note snapshots for Obsidian, with restore-as-checkout semantics.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs --production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node test/build.mjs"
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20.19.6",
    "pnpm": ">=10.25.0"
  },
  "dependencies": {
    "diff": "^8.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "esbuild": "^0.27.1",
    "obsidian": "1.11.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
